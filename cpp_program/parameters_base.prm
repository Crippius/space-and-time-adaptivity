# Configuration file for Heat PDE Solver

# -----------------------------------------------
# Adaptivity Control booleans
# -----------------------------------------------
subsection Adaptivity Control
  set Enable space adaptivity = true
  set Enable time adaptivity = true
  set Enable logs = true
end

subsection Pulsating Gaussian Field
  set Number of spatial peaks = 50
  set Number of temporal peaks = 2
  set Random seed = 42
  set Delta min = 0.07
  set Delta max = 0.01
  set Sigma min = 0.01
  set Sigma max = 0.015
  set Amplitude min = 1.0
  set Amplitude max = 3.0
end


# -----------------------------------------------
# Discretization Params
# -----------------------------------------------
subsection Discretization
  set Degree              = 2
  set Global refinements  = 4
  set Final time          = 2.0
  set Initial deltat      = 0.2
  set Theta               = 0.5
end


# -----------------------------------------------
# Space Adaptivity Params
# -----------------------------------------------
subsection Space Adaptivity
  set Refinement interval = 5
  set Refinement fraction = 0.05
  set Coarsening fraction = 0.5
end


# -----------------------------------------------
# Time Adaptivity Params
# -----------------------------------------------
subsection Time Adaptivity
  set Adaptivity interval  = 2
  set Error lower bound    = 0.1
  set Error upper bound    = 0.5
  set Min deltat           = 0.05
  set Max deltat           = 0.35
end
